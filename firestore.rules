rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para verificar se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Função auxiliar para verificar se o usuário é o dono do recurso
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Regras para coleção de usuários
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Subcoleção de periodizações
      match /periodizations/{periodizationId} {
        allow read, write: if isOwner(userId);
      }
      
      // Subcoleção de treinos
      match /workouts/{workoutId} {
        allow read, write: if isOwner(userId);
      }
      
      // Subcoleção de exercícios
      match /exercises/{exerciseId} {
        allow read, write: if isOwner(userId);
      }
      
      // Subcoleção de PRs
      match /prs/{prId} {
        allow read, write: if isOwner(userId);
      }
      
      // Subcoleção de relação treinos-exercícios
      match /workoutExercises/{workoutExerciseId} {
        allow read, write: if isOwner(userId);
      }
      
      // Subcoleção de assinatura
      match /subscription/{subscriptionId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Transferências de banco de exercícios entre usuários (compartilhamento por e-mail)
    match /exerciseTransfers/{transferId} {
      // Remetente cria a transferência apontando pra si mesmo como fromUid.
      // O e-mail do destinatário precisa vir em minúsculas (normalizado no cliente).
      allow create: if isAuthenticated()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.toEmail is string
        && request.resource.data.exercises is list;

      // Leitura: remetente (por uid) ou destinatário (por e-mail do token, comparação direta).
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUid
        || request.auth.token.email == resource.data.toEmail
      );

      // Update: destinatário muda status (aceitar/recusar) ou remetente cancela.
      allow update: if isAuthenticated()
        && (
          request.auth.uid == resource.data.fromUid
          || request.auth.token.email == resource.data.toEmail
        )
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toEmail == resource.data.toEmail
        && request.resource.data.exercises == resource.data.exercises;

      // Apenas o remetente pode deletar.
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.fromUid;
    }
  }
}

